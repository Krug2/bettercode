{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "**/*.cjs",
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "default-plugins",
    "build"
  ]
}
