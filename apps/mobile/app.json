{
  "expo": {
    "name": "BetterC0de Remote",
    "slug": "betterc0de-remote",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "../shell/build/icon.png",
    "scheme": "betterc0de",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "BetterC0de nutzt die Kamera ausschließlich zum Scannen des Pairing-QR-Codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.betterc0de.remote",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "BetterC0de verbindet sich mit der Desktop-App in deinem lokalen Netzwerk oder Tailnet.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.betterc0de.remote",
      "adaptiveIcon": {
        "foregroundImage": "../shell/build/icon.png",
        "backgroundColor": "#090B0D"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {}
    }
  }
}
